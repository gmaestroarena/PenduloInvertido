--- !u!114 &453172450
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 453172448}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1.- Modificaciones en la Hierarchy:\n          - Eliminamos tanto el slider como txtInstrucciones\n          - Desasignamos los scripts ControlManual de WORLD y FlechaManual de Flecha\n          - Cambiamos el nombre de WORLD por ControlPID\n          - Asignamos Flecha.cs al objeto Flecha\n          - A\xF1adimos los GameObjects (con sus hijos) Menu y PanelControl\n          - Asignamos script ControlPID.cs al objeto ControlPID.\n          - Referenciamos las siguientes variables:\n                   - Rg2D_Carro = carro\n                   - go_barra = barra\n                   - go_esfera = esfera_0   \n          - Asignamos script GUI.cs al objeto GUI.\n          - Referenciamos las siguientes variables:\n                   - Control = ControlPID\n                   - P_Control = PanelControl\n                   - Ob_SliderLimit = Slider_limF       \n                   - Angulo Inicial = AnguloInicial\n                   - B_Play = btn_PLAY   \n                   - B_Pause= btn_PAUSE\n                   - Ob_max_min_control = btn_max_min_control\n\n2.- Del objeto Menu, referenciamos los 4 botones (REINICIAR, PAUSE, PLAY y SALIR) con\n     las funciones correspondientes de GUI.cs, y el Toggle limFuerzaON tambi\xE9n\n\n3.- Del objeto Menu, referenciamos los 2 sliders (Slider_ang y Slider_limF) con las\n     funciones correspondientes incluidas en el script ControlPID.cs del objeto ControlPID.\n\n4.- Del objeto PanelControl, referenciamos los 3 sliders (Kp, Ki, Kd) con CambiarParametrosControl\n     y los 2 botones (btn_PERTURBACION - 1 y 2 -) con las funciones de ControlPID.cs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
