--- !u!114 &2032178297
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2032178295}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1.- Observa los  GameObject que componen la V\xEDa:\n          - tanto
    la V\xEDa como los Topes son RigidBody2D Est\xE1ticos\n\n2.- Observa los distintos
    GameObject que componen el PenduloInvertido:\n          - Carro, Ruedas, Barra
    y Bola son RigidBody2D Din\xE1micos\n          - Modifica valores de los distintos
    par\xE1metros del componente RigidBody2D\n          - Observa el funcionamiento
    de las ligaduras (HingeJoint2D)\n\n3.- Colisiones (V\xEDa + Topes + Ruedas del
    carro):\n           - A la v\xEDa y a los topes les hemos a\xF1adido BoxCollider2D\n          
    - A las ruedas le hemos a\xF1adido CircleCollider2D\n           - As\xED, las
    ruedas, afectadas por la gravedad, caen, arrastrando al resto de\n            
    componentes del PenduloInvertido hasta colisional con la v\xEDa.\n          
    - La v\xEDa (est\xE1tica), no deja que las ruedas sigan cayendo.\n          
    - En la posici\xF3n inicial, existe un Torque pues hay fuerzas que no pasan \n            
    por el centro de masas del sistema. \n           - Esto har\xE1 girar la barra
    y producir\xE1 reacciones en las ligaduras"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
